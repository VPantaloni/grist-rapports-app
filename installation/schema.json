{
  "$description": "Structure du document Grist de l'application (SPEC § 4.2) : source unique des tables, colonnes, types, références et formules. Lue par tests/donnees.js (CSV chargés comme dans Grist) et par scripts/schema.js (vérification des CSV, blocs de documentation). Types Grist : Text, Numeric, Int, Bool, Date, Choice, ChoiceList, Ref:<Table>, RefList:<Table>, Any. Une colonne a soit des données (CSV), soit une formule (formule, ou fichier .py), soit une formule d'initialisation (initialisation). À ADAPTER (APP § 4) : fil rouge Personnes, Projets (la carte ajoute Communes : gabarits/LISEZMOI.md).",
  "tables": [
    {
      "id": "Personnes",
      "role": "fiches des personnes (annuaire) ; Utilisateurs.Personne y renvoie",
      "affichee": "Nom_complet",
      "colonnes": [
        {
          "id": "Prenom",
          "libelle": "Prénom",
          "type": "Text",
          "obligatoire": true
        },
        {
          "id": "Nom",
          "libelle": "Nom",
          "type": "Text",
          "obligatoire": true
        },
        {
          "id": "Email",
          "libelle": "E-mail",
          "type": "Text",
          "role": "unique ; comparé à user.Email par les règles « ma fiche »"
        },
        {
          "id": "Nom_complet",
          "libelle": "Nom complet",
          "type": "Text",
          "formule": "f\"{$Prenom} {$Nom}\"",
          "role": "colonne affichée des références"
        }
      ]
    },
    {
      "id": "Projets",
      "role": "projets suivis (gabarit liste / fiche)",
      "affichee": "Titre",
      "colonnes": [
        {
          "id": "Titre",
          "libelle": "Titre",
          "type": "Text",
          "obligatoire": true,
          "role": "unique"
        },
        {
          "id": "Statut",
          "libelle": "Statut",
          "type": "Choice",
          "choix": [
            "En cours",
            "Terminé"
          ]
        },
        {
          "id": "Responsables",
          "libelle": "Responsables",
          "type": "RefList:Personnes",
          "role": "portée « Limité » des Contributeur·trices"
        },
        {
          "id": "Echeance",
          "libelle": "Échéance",
          "type": "Date"
        },
        {
          "id": "Description",
          "libelle": "Description",
          "type": "Text"
        }
      ]
    },
    {
      "id": "Utilisateurs",
      "role": "comptes d'accès (SPEC § 5.2) ; absent ou inactif = aucun droit",
      "administration": true,
      "affichee": "Email",
      "colonnes": [
        {
          "id": "Email",
          "libelle": "E-mail",
          "type": "Text",
          "obligatoire": true,
          "role": "exactement user.Email, majuscules comprises"
        },
        {
          "id": "Roles",
          "libelle": "Rôles",
          "type": "ChoiceList",
          "choix": [
            "Administrateur·trice",
            "Gestionnaire",
            "Contributeur·trice",
            "Lecteur·trice"
          ]
        },
        {
          "id": "Personne",
          "libelle": "Personne",
          "type": "Ref:Personnes",
          "role": "fiche liée (droits « Limité »)"
        },
        {
          "id": "Actif",
          "libelle": "Actif",
          "type": "Bool"
        },
        {
          "id": "Droits",
          "libelle": "Droits",
          "type": "Any",
          "fichier": "installation/formules/Utilisateurs_Droits.py",
          "role": "\"Table:Action:Niveau\", lu par les règles d'accès"
        },
        {
          "id": "Moi",
          "libelle": "Moi",
          "type": "Bool",
          "formule": "True",
          "role": "vrai seulement sur sa ligne (règle de colonne) : qui suis-je"
        }
      ]
    },
    {
      "id": "Permissions",
      "role": "matrice rôle × table de données (SPEC § 5.2)",
      "administration": true,
      "colonnes": [
        {
          "id": "Role",
          "libelle": "Rôle",
          "type": "Choice",
          "choix": [
            "Administrateur·trice",
            "Gestionnaire",
            "Contributeur·trice",
            "Lecteur·trice"
          ]
        },
        {
          "id": "Table",
          "libelle": "Table",
          "type": "Choice",
          "choix": [
            "Personnes",
            "Projets"
          ]
        },
        {
          "id": "Lire",
          "libelle": "Lire",
          "type": "Choice",
          "choix": [
            "Oui",
            "Non",
            "Limité"
          ]
        },
        {
          "id": "Creer",
          "libelle": "Créer",
          "type": "Choice",
          "choix": [
            "Oui",
            "Non",
            "Limité"
          ]
        },
        {
          "id": "Modifier",
          "libelle": "Modifier",
          "type": "Choice",
          "choix": [
            "Oui",
            "Non",
            "Limité"
          ]
        },
        {
          "id": "Supprimer",
          "libelle": "Supprimer",
          "type": "Choice",
          "choix": [
            "Oui",
            "Non",
            "Limité"
          ]
        }
      ]
    },
    {
      "id": "Navigation",
      "role": "menu de l'application (SPEC § 6.3)",
      "administration": true,
      "colonnes": [
        {
          "id": "Libelle",
          "libelle": "Libellé",
          "type": "Text"
        },
        {
          "id": "Widget",
          "libelle": "Écran",
          "type": "Choice",
          "choix": [
            "personnes",
            "projets",
            "admin"
          ]
        },
        {
          "id": "Ordre",
          "libelle": "Ordre",
          "type": "Numeric"
        },
        {
          "id": "Roles",
          "libelle": "Rôles",
          "type": "ChoiceList",
          "choix": [
            "Administrateur·trice",
            "Gestionnaire",
            "Contributeur·trice",
            "Lecteur·trice",
            "Toute personne connectée"
          ],
          "role": "vide = tout le monde"
        },
        {
          "id": "Visible",
          "libelle": "Visible",
          "type": "Bool"
        }
      ]
    }
  ],
  "$regles": "Règles d'accès propres à l'application (portées « Limité », « ma fiche », campagnes), écrites après les règles générées (matrice T1-T4 de chaque table) par l'écran installer/ ; colonne : règle de colonne. Droits : lettres de Grist (+R, +U, +C, +D, -R…).",
  "regles": [
    {
      "table": "Projets",
      "colonne": "Responsables",
      "condition": "user.Profil and \"Projets:M:Limité\" in user.Profil.Droits and user.Profil.Personne in rec.Responsables",
      "droits": "+U",
      "libelle": "Projets.Responsables : s'ajouter ou se retirer seulement d'un projet dont on est responsable"
    },
    {
      "table": "Projets",
      "condition": "user.Profil and \"Projets:M:Limité\" in user.Profil.Droits and user.Profil.Personne in rec.Responsables and user.Profil.Personne in newRec.Responsables",
      "droits": "+U",
      "libelle": "Projets : modifier un projet dont on reste responsable (Limité)"
    }
  ]
}
